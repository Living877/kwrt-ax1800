# ============ 目标：只编亚瑟这一台 ============
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# 原 Kwrt 配置是“全机型 + 全量包”，那是给 openwrt.ai 出 ipk 仓库用的。
# 个人单机编不划算：29 个机型 × 897 个包，4 核要 6-10 小时，还容易磁盘不足。
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_ALL_NONSHARED is not set

CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y

# ============ 主题：Argon 3.x ============
# 这个包同时提供 argon-config 设置页（LUCI_BASENAME:=argon-config）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ============ 代理 ============
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_unzip=y

# ============ WireGuard ============
# 内核侧始终是模块（CONFIG_WIREGUARD=m），.ko 进 rootfs，不影响 6MiB 内核 FIT。
# 配置入口：网络 → 接口 → 添加新接口 → 协议选 "WireGuard VPN"。
# 注意 luci-app-wireguard 已被上游并入协议层，openwrt/luci 全分支（master /
# openwrt-24.10 / openwrt-25.12）均已无此包，别再找它。
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
# luci-lib-uqr 是 µQR（纯 JS 的 SVG 二维码生成库），luci-proto-wireguard 用它出扫码配置
CONFIG_PACKAGE_luci-lib-uqr=y

# ============ 网络与系统 ============
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
# watchcat 不装：断线自动重启 WAN 的逻辑与 mwan3/自愈脚本重叠，本机不需要。
# CONFIG_PACKAGE_luci-app-watchcat is not set
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-diskman=y
# samba4 保留：把插在路由器上的 U 盘/硬盘共享给局域网（服务端）。
# cifs-mount 不装：它是反向的「把别人的 SMB 共享挂到路由器上」，没有 NAS 设备就不需要。
# zerotier 不装：异地组网与已装的 WireGuard 功能重叠，二选一留 WireGuard（开源、UDP 直连、性能更好）。
# zerotier 去掉后左侧「VPN」一级菜单不会出现；WireGuard 本来就没有独立菜单。
CONFIG_PACKAGE_luci-app-samba4=y
# frp 客户端不装：没有公网入口需要内网穿透，WireGuard 已经够用。
# CONFIG_PACKAGE_luci-app-frpc is not set
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y

# ============ 点名的插件 ============
# timedreboot: 定时重启；automount: 插盘自动挂载（diskman 已有的不重复列）
CONFIG_PACKAGE_luci-app-timedreboot=y
CONFIG_PACKAGE_automount=y
# quickfile: 网页文件管理，依赖 luci-nginx（common/.config 里已 =y）与 quickfile
CONFIG_PACKAGE_luci-app-quickfile=y
# turboacc 已从上游 kiddin9/op-packages 移除（2026-10），但它提供的三项能力全部拆开保留：
# - 流量分载：硬件由 NSS ECM（kmod-qca-nss-ecm）做，比 turboacc 的软件 fast path 更硬；
#   软件分载（flow_offloading）刻意关掉，见 my-default-settings 第 4 段
# - BBR：改用内核模块 kmod-tcp-bbr（common/diy.sh 的 DEFAULT_PACKAGES 已带），
#   运行时由 99-ax1800 写 sysctl 把默认拥塞算法切成 bbr
# - 全锥 NAT（FullCone）：turboacc 只是界面，实现是 firewall4 的 fullcone 支持 +
#   内核 nft fullcone 表达式。diy 里已给主树 firewall4 打上 op-packages 那个补丁，
#   模块从 feeds/kiddin9 的 fullconenat-nft 取，开关是 firewall.@defaults[0].fullcone，
#   由 99-ax1800 首启置 1
CONFIG_PACKAGE_kmod-nft-fullcone=y

# LuCI 运行时：luci-mod-status 自带的 controller/netstat.lua 会 require("luci.netstat")，
# 而该模块只存在于 luci-app-netstat（依赖 +vnstat2，源里没有，装不上）。
# 处理：把 netstat.lua 单独收进 diy/package/base-files/files/usr/lib/lua/luci/，
# 它自身 require 的 luci.jsonc 由这里显式补上，别再依赖别包的传递依赖。
CONFIG_PACKAGE_luci-lib-jsonc=y
# iStore：依赖 mount-utils（util-linux 子包）+ luci-lib-taskd，源里都有
CONFIG_PACKAGE_luci-app-store=y
# 上面这行要被 Kconfig 真正认下来，还差两件事：
#
# 1) tar 的 XZ 支持会带出一条硬依赖。tar 的 Makefile 里是条件依赖
#    TAR_XZ:xz-utils，package-metadata.pl 把它翻译成
#      depends on !(PACKAGE_TAR_XZ) || PACKAGE_xz-utils
#    而 xz-utils 在这棵树里不可见（没有自己的 CONFIG 行），所以只要
#    TAR_XZ=y，luci-app-store 就整体"不可见"——make defconfig 会直接把它
#    丢掉，连 "# CONFIG_PACKAGE_luci-app-store is not set" 都不写。
#    关掉 tar 的 xz 支持即可解开；iStore 只处理 gzip 的 ipk，不受影响。
#    （另一条路是 CONFIG_PACKAGE_xz-utils=y，但那个符号不可见，试不出来。）
# CONFIG_PACKAGE_TAR_XZ is not set
#
# 2) luci.mk 对带 luasrc/ 的包会强加 +luci-lua-runtime；pm.pl 把「+依赖」
#    自身的 depends on 抄到上层，而 Kconfig 的 depends on 不会被 select 满足。
#    显式点开这几环，避免又变成"不可见"。
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_mount-utils=y

# ============ 明确不要（去推广 / 去 Docker） ============
# advancedplus 是 Kwrt 塞进 DEFAULT_PACKAGES 的“进阶设置”，推广载体；
# footstrap-files 是网页版文件编辑器（prism 高亮，体积偏大），本机用 ttyd/nano 够。
# 单靠这里 is not set 压不住，diy.sh 里会从 include/target.mk 删掉。
# CONFIG_PACKAGE_luci-app-advancedplus is not set
# luci-app-package-manager：官方「软件包」页。左侧那个菜单位要给 iStore，
# 两个入口并存只会让人分不清哪个在管包。同样是 common/diy.sh 塞进
# DEFAULT_PACKAGES 的，单靠这里 is not set 压不住，diy.sh 里会一并从
# include/target.mk 删掉。
# CONFIG_PACKAGE_luci-app-package-manager is not set
# CONFIG_PACKAGE_luci-app-footstrap-files is not set
# CONFIG_PACKAGE_luci-app-istorerouter is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-dockermanager is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_runc is not set
# CONFIG_PACKAGE_docker is not set

# ============ 版本信息：把 openwrt.ai 换掉 ============
CONFIG_VERSION_MANUFACTURER="AX1800"
CONFIG_VERSION_HOME_URL="https://github.com/Living877/kwrt-ax1800"
