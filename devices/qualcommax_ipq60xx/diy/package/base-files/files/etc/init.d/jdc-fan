#!/bin/sh /etc/rc.common
# 京东云亚瑟 AX1800 Pro 温控风扇服务

START=95
USE_PROCD=1
PROG=/usr/bin/jdc-fan

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" daemon
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    "$PROG" stop
}
