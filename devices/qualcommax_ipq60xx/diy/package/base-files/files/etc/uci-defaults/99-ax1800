#!/bin/sh
# 首次启动的一次性配置：默认主题 / IPv6 / WAN 的 IPv6 客户端 / WiFi 双频合一
#
# 由 /etc/init.d/boot 的 uci_apply_defaults 用 `.` 引入执行，顺序是：
#   wifi config（生成默认无线配置）→ kmodloader → uci-defaults → 各服务启动
# 所以这里能直接改到 radio0/radio1。ath11k 要 ~80s 才注册 phy（Q6 固件 +
# QMI 握手），此刻 wifi config 生成不出 radio —— 慢路径不 return 1（否则每次
# 开机都在同一早时机重试、永远完不成），而是后台等 phy 出现后补配置，见第 4 段。
#
# 注意：这些值同时会被写入 /etc/config/{network,dhcp,wireless,luci}，
# 刷机后照样能在 LuCI 里改，这里只决定"第一次开机的默认值"。

[ -x /sbin/uci ] || return 1

# ============ 1. 默认主题 Argon 3.x ============
uci -q get luci.main >/dev/null 2>&1 || uci -q set luci.main=core
uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q commit luci

# ============ 2. IPv6：内核已开 CONFIG_IPV6，这里把 LAN 侧分发打开 ============
# ip6assign=60 从 WAN 拿到的 PD 里切 /60 给 LAN；ra/dhcpv6 让下游能拿到地址
uci -q set network.lan.ip6assign='60'
uci -q set dhcp.lan.dhcpv4='server'
uci -q set dhcp.lan.dhcpv6='server'
uci -q set dhcp.lan.ra='server'
uci -q set dhcp.lan.ra_slaac='1'
uci -q delete dhcp.lan.ra_flags
uci -q add_list dhcp.lan.ra_flags='managed-config'
uci -q add_list dhcp.lan.ra_flags='other-config'

# ============ 2.5 BBR：默认拥塞控制切 BBR ============
# turboacc 已从上游移除，BBR 改走内核模块 kmod-tcp-bbr（DEFAULT_PACKAGES 已带）。
# 内核编进了 bbr 但默认算法仍是 cubic，这里运行时切过去，并写进 sysctl.conf
# 让 /etc/init.d/sysctl 每次开机都应用。
if modprobe tcp_bbr 2>/dev/null || [ -d /sys/module/tcp_bbr ]; then
	sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1
	grep -q '^net.ipv4.tcp_congestion_control' /etc/sysctl.conf 2>/dev/null || \
		echo 'net.ipv4.tcp_congestion_control=bbr' >> /etc/sysctl.conf
fi

# ============ 2.6 全锥 NAT（FullCone）============
# turboacc 上游已删，但全锥不依赖它：firewall4 打上 fullcone 补丁后认
# defaults.fullcone，底层是 kmod-nft-fullcone 注册的 nft fullcone 表达式。
# fullcone=1 走 FULLCONENAT（UDP 打洞、BT/游戏联机、P2P 直连都靠它），
# fullcone6 保持 0 —— IPv6 地址本来就端到端，多数场景不需要再 NAT 一层。
# 模块缺失时不写这个开关，让 99-default-settings 那段探测保持"没模块就置 0"。
if modprobe nft_fullcone 2>/dev/null; then
	uci -q set firewall.@defaults[0].fullcone='1'
	uci -q set firewall.@defaults[0].fullcone6='0'
	uci -q commit firewall
else
	logger -t ax1800-net "nft_fullcone 模块缺失，全锥 NAT 未启用"
fi

# ============ 3. WAN：保持 DHCP，只兜底 IPv6 客户端 ============
# config_generate 已按 dhcp 建好 wan + wan6，这里只在 wan6 缺失时补一个，
# device 用 @wan 跟随逻辑接口，将来改成 pppoe 也不用再动。
# 哪天要拨号：LuCI → 网络 → 接口 → WAN → 协议改 PPPoE 填账号即可，
# 记得把「IPv6 分配长度」留空、IPv6 保持 auto，IPv6CP 会自动协商。
if ! uci -q get network.wan6 >/dev/null 2>&1; then
	uci -q set network.wan6='interface'
	uci -q set network.wan6.device='@wan'
	uci -q set network.wan6.proto='dhcpv6'
	uci -q set network.wan6.reqaddress='try'
	uci -q set network.wan6.reqprefix='auto'
fi

# 主题/IPv6/WAN 先落盘，让它们不依赖第 4 段无线是否就绪都能立即生效。
uci -q commit network
uci -q commit dhcp

# 真正的保障是 /etc/init.d/caldata-early（START=09，早于 ath11k 模块加载，
# 每次开机都会检查）。这里只补一句 enable，防止打包时 rc.d 软链没自动建出来。
if [ -x /etc/init.d/caldata-early ]; then
	/etc/init.d/caldata-early enable 2>/dev/null
fi

# 同理，NSS 固件的别名与固件等待超时也由 /etc/init.d/nss-fw-early（START=08）
# 在模块加载前处理，这里只补 enable。
if [ -x /etc/init.d/nss-fw-early ]; then
	/etc/init.d/nss-fw-early enable 2>/dev/null
fi

# ============ 3.5 cal 兜底：ath11k 校准数据 ============
# ath11k 在 Q6 起来后（~80s）通过 QMI 请求 cal-ahb-c000000.wifi.bin。
# 上游 11-ath11k-caldata 热插拔脚本本应自动从 eMMC 的 0:ART 分区切出它，
# 但首次启动（刷机后）偶发因 board_name/分区枚举时序失败，驱动等 60s 后
# -110 超时、phy 不完整。这里在 boot 早期（远早于 80s）主动生成一份；
# 文件已存在时，hotplug 脚本首行 `[ -e ... ] && exit 0` 会直接跳过。
if [ -e /tmp/sysinfo/board_name ] && \
   [ ! -e /lib/firmware/ath11k/IPQ6018/hw1.0/cal-ahb-c000000.wifi.bin ]; then
	# 关键：caldata_extract_mmc 失败时内部 caldata_die 会 exit 1，
	# 而 caldata.sh 是被 source 进来的，exit 会连带退出本脚本 ——
	# 导致后面的 WiFi 段不执行、脚本被留到下次重试。必须子 shell 隔离，
	# 让 cal 失败只影响 cal 兜底本身，主流程照常走到 WiFi 段并 return 0。
	(
		. /lib/functions/caldata.sh 2>/dev/null
		[ "$(board_name)" = "jdcloud,re-ss-01" ] || exit 0
		FIRMWARE='ath11k/IPQ6018/hw1.0/cal-ahb-c000000.wifi.bin'
		caldata_extract_mmc '0:ART' 0x1000 0x10000 2>/dev/null
	) || true
fi

# ============ 4. WiFi 双频合一 ============
# 每个 radio 的 iface 用同一组 SSID/密码，即 2.4G 与 5G 同名。
#
# 漫游字段（openwrt-25.12 wifi-scripts 实测）：
#   ieee80211k = 有效，ap.uc 里翻译成 hostapd 的 rrm_neighbor_report / rrm_beacon_report
#   bss_transition = 11v 的真正开关（wmnmode）。⚠️ 不要再写 ieee80211v，
#     25.12 的 iface schema 里已无此字段，写了只会打 "not present in the schema" 告警且不生效
#   ieee80211r = 有效，单台机器用不上，且部分老设备开了直接连不上，关掉
WIFI_SSID='CLI'
WIFI_KEY='__WIFI_KEY__'

# 把默认值套到已生成的 radio/iface 上（同步快路径与后台兜底路径共用）。
apply_wifi_defaults() {
	local i=0 r
	while uci -q get "wireless.@wifi-iface[$i]" >/dev/null 2>&1; do
		uci -q set "wireless.@wifi-iface[$i].ssid=$WIFI_SSID"
		uci -q set "wireless.@wifi-iface[$i].key=$WIFI_KEY"
		uci -q set "wireless.@wifi-iface[$i].encryption=psk2"
		uci -q set "wireless.@wifi-iface[$i].disabled=0"
		uci -q set "wireless.@wifi-iface[$i].ieee80211k=1"
		uci -q set "wireless.@wifi-iface[$i].bss_transition=1"
		uci -q set "wireless.@wifi-iface[$i].wnm_sleep_mode=1"
		uci -q set "wireless.@wifi-iface[$i].disassoc_low_ack=0"
		uci -q set "wireless.@wifi-iface[$i].ieee80211r=0"
		i=$((i + 1))
	done
	[ "$i" -gt 0 ] || return 1

	# 按频段定带宽：2.4G HT40，5G HE80（160MHz 在亚瑟上容易掉速）
	# 注意 band 值是 mac80211.uc 里 lc(band_name) 生成的小写 2g/5g
	for r in $(uci -q show wireless | sed -n 's/^wireless\.\(radio[0-9]*\)=wifi-device$/\1/p'); do
		case "$(uci -q get "wireless.$r.band")" in
			2g) uci -q set "wireless.$r.htmode=HT40" ;;
			5g) uci -q set "wireless.$r.htmode=HE80" ;;
		esac
		uci -q set "wireless.$r.disabled=0"
	done
	uci -q commit wireless
}

[ -f /etc/board.json ] || return 1
uci -q get wireless.@wifi-iface[0] >/dev/null 2>&1 || /sbin/wifi config

# 快路径：phy 已在（极少见），同步套默认值
if uci -q get wireless.@wifi-iface[0] >/dev/null 2>&1; then
	apply_wifi_defaults || return 1
	return 0
fi

# 慢路径：ath11k 要 ~80s 才注册 phy（Q6 固件 + QMI 握手），此刻 wifi config
# 生成不出 radio。不能 return 1 —— 下次开机仍在同一早时机，永远重试不完。
# 改后台等 phy 出现后补配置；这只在刷机后首次启动发生，之后无线配置已持久化。
(
	i=0
	while [ $i -lt 180 ]; do
		[ -n "$(ls /sys/class/ieee80211/ 2>/dev/null)" ] && break
		sleep 1
		i=$((i + 1))
	done
	if [ -z "$(ls /sys/class/ieee80211/ 2>/dev/null)" ]; then
		logger -t ax1800-wifi "等 180s 仍无 phy，ath11k 未就绪"
		exit 0
	fi
	logger -t ax1800-wifi "phy 就绪，补生成无线配置"
	/sbin/wifi config
	uci -q get wireless.@wifi-iface[0] >/dev/null 2>&1 || { logger -t ax1800-wifi "wifi config 后仍无 iface"; exit 0; }
	apply_wifi_defaults || { logger -t ax1800-wifi "apply_wifi_defaults 失败"; exit 0; }
	/sbin/wifi reload
	logger -t ax1800-wifi "无线默认值已应用并 reload"
) >/dev/null 2>&1 &

return 0
